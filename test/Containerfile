# fio-ext4-test — fio-ext4's test image, per stormcentral
# docs/test-standard.md. One image for all three suites: the Job runs
# `/test short|medium|long`.
#
# It builds images in userspace and judges them with e2fsck -fn. The kernel
# half of CLAUDE.md rule 4 (loop-mount, compare, write) runs in the
# tests/vm/ testhost VM; in this unprivileged pod those checks report skip.
# test/build.sh stages static fio-ext4 and mkfs-ext4; this adds e2fsck,
# losetup and mount (used only where a loop device exists), and tar and gzip
# to make a layer — which is why it is fedora-minimal and not scratch.
FROM registry.fedoraproject.org/fedora-minimal:43
ARG COMMIT=unknown
LABEL storm.io/test-of="fio.ext4.rs" storm.io/test-commit="${COMMIT}"
RUN microdnf -y install --setopt=install_weak_deps=0 e2fsprogs util-linux tar gzip coreutils && microdnf clean all
COPY test/.stage/fio-ext4 test/.stage/mkfs-ext4 /usr/local/bin/
COPY test/.stage/test /test
ENTRYPOINT ["/test"]
